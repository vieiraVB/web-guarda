generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                 BigInt   @id @default(autoincrement())
  codigoParticipante String   @unique @db.Uuid
  nome               String
  email              String   @unique
  senhaHash          String
  perfil             String
  criadoEm           DateTime @default(now())

  acessosConteudo AcessoConteudo[]
  tentativas      Tentativa[]
  conclusoesEtapa ConclusaoEtapa[]
}

model Conteudo {
  id        BigInt   @id @default(autoincrement())
  titulo    String
  tema      String
  corpo     String
  ordem     Int
  publicado Boolean  @default(false)
  criadoEm  DateTime @default(now())

  acessos AcessoConteudo[]
  etapas  EtapaConteudo[]
}

model AcessoConteudo {
  usuarioId   BigInt
  conteudoId  BigInt
  acessadoEm  DateTime  @default(now())
  concluidoEm DateTime?

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  conteudo Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, conteudoId])
  @@index([conteudoId])
}

model EtapaConteudo {
  id         BigInt   @id @default(autoincrement())
  conteudoId BigInt
  titulo     String
  corpo      String
  ordem      Int
  criadoEm   DateTime @default(now())

  conteudo    Conteudo         @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  conclusoes  ConclusaoEtapa[]

  @@unique([conteudoId, ordem])
  @@index([conteudoId])
}

model ConclusaoEtapa {
  usuarioId   BigInt
  etapaId     BigInt
  concluidaEm DateTime @default(now())

  etapa   EtapaConteudo @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  usuario Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, etapaId])
  @@index([etapaId])
}

model Questionario {
  id              BigInt  @id @default(autoincrement())
  grupoComparacao String
  fase            String
  versao          Int
  titulo          String
  ativo           Boolean @default(false)

  questoes   QuestionarioQuestao[]
  tentativas Tentativa[]
  respostas  Resposta[]

  @@unique([grupoComparacao, versao, fase])
}

model Questao {
  id        BigInt  @id @default(autoincrement())
  enunciado String
  tema      String
  ativa     Boolean @default(true)

  questionarios QuestionarioQuestao[]
  alternativas  Alternativa[]
  respostas     Resposta[]
}

model QuestionarioQuestao {
  questionarioId BigInt
  questaoId      BigInt
  ordem          Int
  peso           Decimal

  questionario Questionario @relation(fields: [questionarioId], references: [id], onDelete: Cascade)
  questao      Questao      @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  @@id([questionarioId, questaoId])
  @@unique([questionarioId, ordem])
  @@index([questaoId])
}

model Alternativa {
  id        BigInt  @id @default(autoincrement())
  questaoId BigInt
  texto     String
  correta   Boolean @default(false)

  questao   Questao    @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  respostas Resposta[]

  @@unique([questaoId, id])
  @@index([questaoId])
}

model Tentativa {
  id                  BigInt    @id @default(autoincrement())
  usuarioId           BigInt
  questionarioId      BigInt
  status              String
  pontuacaoPercentual Decimal?
  iniciadaEm          DateTime  @default(now())
  concluidaEm         DateTime?

  usuario      Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  questionario Questionario @relation(fields: [questionarioId], references: [id], onDelete: Cascade)
  respostas    Resposta[]

  @@unique([usuarioId, questionarioId])
  @@unique([id, questionarioId])
  @@index([usuarioId])
  @@index([questionarioId])
}

model Resposta {
  id             BigInt @id @default(autoincrement())
  tentativaId    BigInt
  questionarioId BigInt
  questaoId      BigInt
  alternativaId  BigInt

  tentativa    Tentativa    @relation(fields: [tentativaId, questionarioId], references: [id, questionarioId], onDelete: Cascade)
  questionario Questionario @relation(fields: [questionarioId], references: [id], onDelete: Cascade)
  questao      Questao      @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  alternativa  Alternativa  @relation(fields: [questaoId, alternativaId], references: [questaoId, id], onDelete: Cascade)

  @@unique([tentativaId, questaoId])
  @@index([tentativaId, questionarioId])
  @@index([questionarioId, questaoId])
}

model Feedback {
  id         BigInt   @id @default(autoincrement())
  comentario String
  criadoEm   DateTime @default(now())
}
